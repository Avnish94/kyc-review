# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://kyc:kyc@localhost:5432/kyc"
SESSION_SECRET="dev-only-insecure-secret-change-me-0123456789"
APP_BASE_URL="http://localhost:3000"

# --- Authentication -----------------------------------------------------
# Mock email/password login (demo accounts). Defaults to on unless Entra ID is configured.
# AUTH_MOCK_ENABLED="true"

# Microsoft Entra ID (OIDC). Leave blank to disable single sign-on.
# AUTH_ENTRA_TENANT_ID=""
# AUTH_ENTRA_CLIENT_ID=""
# AUTH_ENTRA_CLIENT_SECRET=""
# App role values (Entra app registration -> App roles) mapped to application roles.
# AUTH_ENTRA_ADMIN_ROLE="KYC.Admin"
# AUTH_ENTRA_ANALYST_ROLE="KYC.Analyst"
# Override the issuer (e.g. the local mock OIDC server: http://localhost:4010).
# AUTH_OIDC_ISSUER=""

# --- Document storage ---------------------------------------------------
STORAGE_DRIVER="local" # local | azure
LOCAL_STORAGE_DIR="./storage"
# AZURE_STORAGE_CONNECTION_STRING=""
# AZURE_STORAGE_CONTAINER="kyc-documents"

# --- Integrations -------------------------------------------------------
# Shared secret used to verify HMAC signatures on screening-provider webhooks.
SCREENING_WEBHOOK_SECRET="dev-only-screening-webhook-secret"
# Microsoft Teams incoming webhook (Workflows "When a Teams webhook request is received").
# TEAMS_WEBHOOK_URL=""
